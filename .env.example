# ── Copy this file to .env and adjust as needed ────────────────────────
# The .env file is git-ignored so real values never get committed.

# --- Embedding model (Hugging Face id, downloaded once, cached locally) ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- Vector store ---
CHROMA_DIR=./data/chroma_db
COLLECTION_NAME=cbx_docs

# --- Chunking ---
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# --- Retrieval ---
TOP_K=5

# --- Generation LLM ---
# LLM_PROVIDER: "ollama" (local default) or "openai" (any OpenAI-compatible
# hosted endpoint — Groq, OpenRouter, Together, OpenAI — used for cloud deploys).
LLM_PROVIDER=ollama

# Local (ollama): the RAG app talks to the load balancer, which forwards to Ollama.
LLM_MODEL=qwen2.5:7b
LB_URL=http://127.0.0.1:8080

# Hosted (openai): set these when LLM_PROVIDER=openai. Set LLM_MODEL to a model
# the provider serves (e.g. llama-3.1-8b-instant on Groq). Keep the key in .env.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=

# --- Load balancer: comma-separated list of Ollama backend URLs ---
# Single backend for now; add more later e.g. http://127.0.0.1:11434,http://127.0.0.1:11435
OLLAMA_BACKENDS=http://127.0.0.1:11434

# --- Servers ---
RAG_API_HOST=127.0.0.1
RAG_API_PORT=8000
LB_HOST=127.0.0.1
LB_PORT=8080

# ── Ticket connectors (fill in only the source you use; secrets stay local) ──
# Jira Cloud
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_JQL=statusCategory = Done ORDER BY updated DESC

# Zendesk
ZENDESK_SUBDOMAIN=
ZENDESK_EMAIL=
ZENDESK_API_TOKEN=
ZENDESK_QUERY=type:ticket status:solved

# Freshservice
FRESHSERVICE_DOMAIN=
FRESHSERVICE_API_KEY=

# Generic REST source
GENERIC_URL=
GENERIC_AUTH_HEADER=
GENERIC_RESULTS_PATH=
GENERIC_FIELD_MAP=
