# ── Copy this file to .env and adjust as needed ────────────────────────
# The .env file is git-ignored so real values never get committed.

# --- Embedding model (Hugging Face id, downloaded once, cached locally) ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- Vector store ---
CHROMA_DIR=./data/chroma_db
COLLECTION_NAME=cbx_docs

# --- Chunking ---
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# --- Retrieval ---
TOP_K=5

# --- Generation LLM (served by Ollama) ---
# The RAG app talks to the load balancer, which forwards to Ollama backend(s).
LLM_MODEL=qwen2.5:7b
LB_URL=http://127.0.0.1:8080

# --- Load balancer: comma-separated list of Ollama backend URLs ---
# Single backend for now; add more later e.g. http://127.0.0.1:11434,http://127.0.0.1:11435
OLLAMA_BACKENDS=http://127.0.0.1:11434

# --- Servers ---
RAG_API_HOST=127.0.0.1
RAG_API_PORT=8000
LB_HOST=127.0.0.1
LB_PORT=8080
